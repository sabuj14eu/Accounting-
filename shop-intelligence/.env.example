# Shop Profit Intelligence — its own environment, sharing nothing.
#
# §2: own database, own tables, own migrations, own authentication, own session
# store, own storage, own queues, own credentials. If a value here also appears
# in the accounting application's .env, one of the two is wrong.

APP_NAME="Shop Intelligence"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://shop.signalmesh.dev

# --- Its own database. Never the accounting schema, never a shared user. ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shop_intelligence
DB_USERNAME=shop_intelligence
DB_PASSWORD=

# --- Its own session and cache. A shared store is a shared login. ---
SESSION_DRIVER=database
SESSION_CONNECTION=mysql
SESSION_DOMAIN=shop.signalmesh.dev
SESSION_COOKIE=shop_intelligence_session
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Its own storage root. ---
FILESYSTEM_DISK=local
SHOP_STORAGE_ROOT=/var/lib/shop-intelligence

# --- Analysis thresholds. All management, none of them tax. ---
#
# EVERY VALUE BELOW IS AN UNVALIDATED DEFAULT. None came from this shop's data;
# they are starting points that mirror the code defaults so the two cannot
# drift apart. Set each one from the shop's own history, record who set it and
# when, or leave it deliberately at the default and say so on screen. Passing
# tests do not make a threshold a business truth.
#
# Nothing reads this file yet: the analysis core takes thresholds as
# constructor arguments (PriceReview, StockLine, ShopMonitor, PlatformSettlement,
# AccountsComparison, CashLedger). A configuration layer that maps these keys
# onto those arguments is P0 work and does not exist.
SHOP_TARGET_MARGIN_PERCENT=65           # PriceReview::$targetMarginPercent
SHOP_WARNING_MARGIN_PERCENT=55          # PriceReview::$warningMarginPercent
SHOP_STOCK_TOLERANCE_PERCENT=2          # StockLine::$tolerancePercent
SHOP_FOOD_COST_GAP_ALERT_PERCENT=5      # StockReconciliation, FOOD_COST_ABOVE_RECIPE (hard-coded today)
SHOP_CASH_TOLERANCE_GROSZE=0            # CashLedger::$tolerance
SHOP_PLATFORM_TOLERANCE_GROSZE=0        # PlatformSettlement::$tolerance
SHOP_PLATFORM_REVIEW_THRESHOLD_PERCENT=1   # PlatformSettlement::$reviewThresholdPercent
SHOP_REVENUE_DROP_ALERT_PERCENT=-15     # ShopMonitor::$revenueDropPercent
SHOP_COST_RISE_ALERT_PERCENT=20         # ShopMonitor::$costRisePercent
SHOP_MARGIN_DROP_ALERT_POINTS=5         # ShopMonitor::$marginDropPoints
SHOP_BASELINE_MINIMUM_PERIODS=3         # Baseline::MINIMUM_PERIODS (a constant today)
SHOP_ACCOUNTS_COMPARISON_TOLERANCE_PERCENT=2   # AccountsComparison::$tolerancePercent

# --- What is deliberately absent, and must stay absent. ---
# There is no KSEF_TOKEN here, and no code that would read one.
# There is no ACCOUNTING_DB_* here, and no client that would connect to it.
# There is no MT5, broker or trading variable here, and no path that reaches one.
# Official figures enter this application only as a snapshot somebody imports
# by hand, recorded with who imported it and from what.
