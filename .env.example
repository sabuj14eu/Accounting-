# ---------------------------------------------------------------------------
# Accounting application — account.signalmesh.dev
#
# THIS FILE MUST NEVER CONTAIN A TRADING CREDENTIAL. No MT5 login, no broker
# key, no bot API secret, no executor token, no trading database password.
# The accounting application has no reason to hold one and no code path that
# would use one.
# ---------------------------------------------------------------------------

APP_NAME="SignalMesh Accounts"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://account.signalmesh.dev
APP_LOCALE=pl
APP_TIMEZONE=Europe/Warsaw

# --- Its own database. Never the trading database, never a shared user. ------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=accounting
DB_USERNAME=accounting
DB_PASSWORD=

# --- Its own queue, cache and session. Separate Redis DB index at minimum. ---
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=3
REDIS_CACHE_DB=4

# --- Poland module ----------------------------------------------------------
# MUST be true in production. With it on, the engine refuses to settle a month
# using rate tables that have not been confirmed against the issuing authority's
# own publication. See docs/RATE_VERIFICATION.md.
POLAND_REQUIRE_OFFICIAL_RATES=true

# Point this at the published rate tables when a rate must be updated between
# releases: `php artisan vendor:publish --tag=poland-rates`.
POLAND_RATES_PATH=
POLAND_ROUTE_PREFIX=poland
POLAND_LOCALE=pl

# --- KSeF (stage C: real transport built against API 2.0 / OpenAPI 2.7.1) ---
# Never log these values. The token itself is NOT an env value: store it with
# `php artisan poland:ksef-token` (hidden prompt, encrypted at rest).
KSEF_ENVIRONMENT=test
# Stays DISABLED until `php artisan poland:ksef-check` passes all 12 steps on
# the TEST environment (docs/KSEF_GO_LIVE.md). Production may never use "fake":
# the gate throws rather than letting a lost connection read as "no invoices".
KSEF_TRANSPORT_ENABLED=false
KSEF_TRANSPORT=disabled
# The egress registry entry (config/poland.php → egress.ksef). Both must be set
# consciously: who allowed this application to talk to KSeF, and when.
KSEF_EGRESS_ENABLED=false
KSEF_EGRESS_AUTHORISED_BY=
KSEF_EGRESS_AUTHORISED_ON=
# Official base URLs are the defaults in config/poland.php; override only if
# the Ministry moves them.
KSEF_BASE_URL_TEST=
KSEF_BASE_URL_DEMO=
KSEF_BASE_URL_PRODUCTION=
KSEF_LOOKBACK_DAYS=45
KSEF_SYNC_EVERY_MINUTES=120
KSEF_PAGE_SIZE=100
KSEF_CA_BUNDLE=

# --- NBP exchange rates (Phase 2) -------------------------------------------
NBP_BASE_URL=https://api.nbp.pl/api
NBP_TABLE=A

# --- Mail -------------------------------------------------------------------
MAIL_MAILER=log
