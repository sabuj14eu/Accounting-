# ---------------------------------------------------------------------------
# Accounting application — account.signalmesh.dev
#
# THIS FILE MUST NEVER CONTAIN A TRADING CREDENTIAL. No MT5 login, no broker
# key, no bot API secret, no executor token, no trading database password.
# The accounting application has no reason to hold one and no code path that
# would use one.
# ---------------------------------------------------------------------------

APP_NAME="SignalMesh Accounts"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://account.signalmesh.dev
APP_LOCALE=pl
APP_TIMEZONE=Europe/Warsaw

# --- Its own database. Never the trading database, never a shared user. ------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=accounting
DB_USERNAME=accounting
DB_PASSWORD=

# --- Its own queue, cache and session. Separate Redis DB index at minimum. ---
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=3
REDIS_CACHE_DB=4

# --- Poland module ----------------------------------------------------------
# MUST be true in production. With it on, the engine refuses to settle a month
# using rate tables that have not been confirmed against the issuing authority's
# own publication. See docs/RATE_VERIFICATION.md.
POLAND_REQUIRE_OFFICIAL_RATES=true

# Point this at the published rate tables when a rate must be updated between
# releases: `php artisan vendor:publish --tag=poland-rates`.
POLAND_RATES_PATH=
POLAND_ROUTE_PREFIX=poland
POLAND_LOCALE=pl

# --- KSeF 2.0 / FA(3) --------------------------------------------------------
# Official API 2.7.1, invoice schema FA(3) 1-0E (modules/poland/resources/ksef/PINNED.md).
# Five modes: DISABLED · FAKE · TEST · DEMO · PRODUCTION.
#   KSEF_ENVIRONMENT  test | demo | production   (the deployment's environment;
#                     a token issued for one is never sent to another)
#   KSEF_TRANSPORT    disabled | fake | real     (production REFUSES fake at boot)
#   KSEF_TRANSPORT_ENABLED  false | true
# Production stays OFF until every gate in docs/KSEF_PRODUCTION_GATE.md passes.
# The first real environment is TEST, never production.
KSEF_ENVIRONMENT=test
KSEF_TRANSPORT_ENABLED=false
KSEF_TRANSPORT=disabled
# Base URLs live in config/poland.php. KSEF_BASE_URL may override TEST/DEMO
# only (a proxy or mirror); production cannot be overridden.
KSEF_BASE_URL=
KSEF_NIP=
# The KSeF token is NOT configured here. It is pasted once in
# Settings → Poland → KSeF (step 3), stored encrypted, never displayed again.
# Never put a token value in this file. Never log it.
KSEF_TOKEN=
# Timeouts (seconds) and limits — every request has both.
KSEF_CONNECT_TIMEOUT=10
KSEF_REQUEST_TIMEOUT=30
KSEF_UPLOAD_TIMEOUT=60
KSEF_DOWNLOAD_TIMEOUT=60
# Scheduled incoming synchronisation is opt-in; status polling runs when the
# transport is enabled; sending is never scheduled.
KSEF_SYNC_SCHEDULE_ENABLED=false
KSEF_SYNC_SCHEDULE_TIME=03:15
KSEF_SYSTEM_INFO="SignalMesh Accounts"

# --- NBP exchange rates (Phase 2) -------------------------------------------
NBP_BASE_URL=https://api.nbp.pl/api
NBP_TABLE=A

# --- Mail -------------------------------------------------------------------
MAIL_MAILER=log
